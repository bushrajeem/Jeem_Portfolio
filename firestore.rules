rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//  Jeem Portfolio · Firestore Security Rules
//
//  Locked strictly to ONLY your verified Google email + Firebase Auth UID.
//  Even if another user signs in with Google or copies your public API key,
//  Google's servers reject every admin read/write immediately.
//
//  ONE-TIME SETUP: replace PASTE_YOUR_ADMIN_UID_HERE with your Firebase Auth UID
//  (shown in Admin Studio when signed in with bushrajeem32@gmail.com), then
//  paste into Firebase Console → Firestore Database → Rules → Publish.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'bushrajeem32@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid in ['PASTE_YOUR_ADMIN_UID_HERE'];
    }

    function validItemId(itemId) {
      return itemId.matches('^[a-z0-9][a-z0-9-]{0,59}$');
    }

    function stampedNow() {
      return request.resource.data.updatedAt == request.time;
    }

    function validCollectionItem(itemId) {
      return isAdmin()
        && validItemId(itemId)
        && stampedNow()
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order <= 1000
        && request.resource.data.visible is bool
        && request.resource.data.size() <= 30;
    }

    // ── Public portfolio content (anyone can read, only admin can write) ─────
    match /portfolio/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && docId in ['profile', 'academics', 'hero', 'bio', 'navigation']
        && stampedNow()
        && request.resource.data.size() <= 30;
      allow delete: if false;
    }

    match /skills/{itemId} {
      allow read: if true;
      allow create, update: if validCollectionItem(itemId);
      allow delete: if isAdmin();
    }

    match /projects/{itemId} {
      allow read: if true;
      allow create, update: if validCollectionItem(itemId);
      allow delete: if isAdmin();
    }

    match /journey/{itemId} {
      allow read: if true;
      allow create, update: if validCollectionItem(itemId);
      allow delete: if isAdmin();
    }

    match /milestones/{itemId} {
      allow read: if true;
      allow create, update: if validCollectionItem(itemId);
      allow delete: if isAdmin();
    }

    // ── Contact form inbox ───────────────────────────────────────────────────
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'email',
          'message',
          'status',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'unread'
        && request.resource.data.createdAt == request.time;

      allow read, delete: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['read', 'unread'];
    }

    // ── Tamper-proof audit log ───────────────────────────────────────────────
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'section', 'uid', 'email', 'at'])
        && request.resource.data.keys().hasAll(['action', 'section', 'uid', 'email', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 200
        && request.resource.data.section is string
        && request.resource.data.section.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
      allow update, delete: if false;
    }

    // ── Everything else is locked ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
