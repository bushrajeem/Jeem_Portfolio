# Firebase Web App Configuration
# Copy this file to .env.local and replace the values from:
# Firebase Console -> Project settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional (only needed if you enable Google Analytics in Firebase)
VITE_FIREBASE_MEASUREMENT_ID=

# Owner email allowed to sign into /admin (defaults to bushrajeem32@gmail.com)
VITE_ADMIN_EMAIL=bushrajeem32@gmail.com

# Optional: Firebase App Check (reCAPTCHA v3 site key) to block bots/API abuse.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional: Free Cloudinary unsigned upload (alternative to Firebase Storage if on Spark plan)
# Cloudinary Dashboard -> Settings -> Upload -> Add unsigned upload preset
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
